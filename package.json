{
  "name": "@etium/core",
  "version": "0.13.0",
  "description": "The outer loop for coding agents. Etium supervises headless harnesses: tasks, runs, budgets, gates, and an append-only event ledger.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "etium": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "ralph",
    "ai-engineer",
    "schema",
    "README.md",
    "QUICKSTART.md",
    "WRITING_LOOPS.md",
    "DESIGN.md",
    "DECISIONS.md",
    "MODEL_AUTH.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etium-dev/core.git"
  },
  "homepage": "https://etium.dev/",
  "keywords": [
    "agents",
    "loop-engineering",
    "coding-agents",
    "orchestration",
    "supervisor",
    "codex",
    "claude-code",
    "pi",
    "openhands"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "test": "node --test",
    "budget": "node scripts/loc-budget.mjs",
    "prepublishOnly": "npm run build && npm test && npm run budget"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
